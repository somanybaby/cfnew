{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "cfnew-js-rewrite-local",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-11-02",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  // For local testing only. No production account, namespace or route is configured.
  "kv_namespaces": [{ "binding": "C", "id": "00000000000000000000000000000000" }],
  "vars": { "ena": "yes", "dkby": "yes" }
}
